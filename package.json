{
  "name": "@spautz/playground-public",
  "private": true,
  "description": "Various demos and proof-of-concept attempts",
  "license": "MIT",
  "homepage": "https://github.com/spautz/playground-public#readme",
  "bugs": "https://github.com/spautz/playground-public/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spautz/playground-public.git"
  },
  "author": {
    "name": "Steven Pautz",
    "url": "https://stevenpautz.com/"
  },
  "engines": {
    "node": "^26",
    "pnpm": ">=12.6.0 <13"
  },
  "packageManager": "pnpm@12.6.0+sha512.3ef68f951cb111ac204b4a5a16f0b2ddf0da56a96e0413e81d855d9f0b55ef926714709028e1cd00c405c2c5fb7b9e8ec4dc46777c805d0373c2f2ff00fd20ec",
  "type": "module",
  "scripts": {
    "____ HOOKS _________________________________________________________": "",
    "preinstall": "npx only-allow pnpm",
    "prepare": "husky",
    "husky:precommit": "lint-staged",
    "husky:prepush": "pnpm run format:verify",
    "____ STANDARD DEV TASKS ____________________________________________": "",
    "all": "pnpm run format",
    "all:ci": "pnpm run format:verify",
    "____ INDIVIDUAL COMMANDS ___________________________________________": "",
    "dev": "http-server ./public",
    "start": "http-server ./public --dir-list-count -1",
    "deploy:github": "gh-pages -d ./public",
    "format": "prettier --write .",
    "format:verify": "prettier --list-different ."
  },
  "devDependencies": {
    "gh-pages": "6.3.0",
    "http-server": "14.1.1",
    "husky": "9.1.7",
    "lint-staged": "17.5.1",
    "prettier": "3.9.8"
  },
  "lint-staged": {
    "*.{cjs,cts,css,html,js,jsx,json,jsonc,less,md,mdx,mjs,mts,scss,ts,tsx,yaml}": [
      "prettier --write"
    ]
  }
}
